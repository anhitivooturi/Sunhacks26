# Empty DATABASE_URL selects a temporary in-memory demo. Nothing survives restart.
DATABASE_URL=
PORT=3000
HOST=127.0.0.1
BASE_URL=http://localhost:3000
# Browser dev servers allowed by CORS; deployed same-origin clients need no entry.
CORS_ORIGINS=http://localhost:5173
CONFUSION_THRESHOLD=0.3
AI_TIMEOUT_MS=20000
LOG_LEVEL=info
