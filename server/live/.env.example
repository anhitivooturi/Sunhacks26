# Empty DATABASE_URL selects a temporary in-memory demo. Nothing survives restart.
DATABASE_URL=
PORT=3000
HOST=127.0.0.1
BASE_URL=http://localhost:3000
# Browser dev servers allowed by CORS; deployed same-origin clients need no entry.
CORS_ORIGINS=http://localhost:5173
CONFUSION_THRESHOLD=0.3
AI_TIMEOUT_MS=20000
LOG_LEVEL=info
# Person B. Keep Google billing disabled to use the model's free quota.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Direct AWS Transcribe is opt-in; the EC2 Whisper worker uses a different provider.
TRANSCRIBE_ENABLED=false
TRANSCRIPTION_PROVIDER=browser
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
WHISPER_URL=
WHISPER_TOKEN=
TRANSCRIBE_MAX_STREAMS=2
TRANSCRIBE_MAX_SESSION_SECONDS=3600
