# MongoDB Atlas: Atlas > your cluster > Connect > Drivers > Node.js. Replace <db_password> with your DATABASE USER's password
# (Database Access, not your Atlas login). URL-encode special characters (@ = %40, # = %23).
# Leave MONGODB_URI empty to use a local JSON file (server/atlas/.data.json) instead. Nothing then reaches Atlas.
MONGODB_URI=
MONGODB_DB=pulse
API_PORT=3001
